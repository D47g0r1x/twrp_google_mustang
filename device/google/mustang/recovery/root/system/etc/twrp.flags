# TWRP flags for Pixel 10 Pro XL (mustang)

/boot                    emmc      /dev/block/platform/3c400000.ufs/by-name/boot                    flags=display="Boot";backup=1;flashimg=1;slotselect
/init_boot               emmc      /dev/block/platform/3c400000.ufs/by-name/init_boot               flags=display="Init Boot";backup=1;flashimg=1;slotselect
/vendor_boot             emmc      /dev/block/platform/3c400000.ufs/by-name/vendor_boot             flags=display="Vendor Boot";backup=1;flashimg=1;slotselect
/vendor_kernel_boot      emmc      /dev/block/platform/3c400000.ufs/by-name/vendor_kernel_boot      flags=display="Vendor Kernel Boot";backup=1;flashimg=1;slotselect
/misc                    emmc      /dev/block/platform/3c400000.ufs/by-name/misc                    flags=display="Misc"
/vbmeta                  emmc      /dev/block/platform/3c400000.ufs/by-name/vbmeta                  flags=display="VBMeta";backup=1;flashimg=1;slotselect
/vbmeta_system           emmc      /dev/block/platform/3c400000.ufs/by-name/vbmeta_system           flags=display="VBMeta System";backup=1;flashimg=1;slotselect
/vbmeta_vendor           emmc      /dev/block/platform/3c400000.ufs/by-name/vbmeta_vendor           flags=display="VBMeta Vendor";backup=1;flashimg=1;slotselect

# Dynamic partitions (for backup / manual flashing)
/system_image            emmc      /dev/block/by-name/system                                        flags=display="System Image";backup=1;flashimg=1
/vendor_image            emmc      /dev/block/by-name/vendor                                        flags=display="Vendor Image";backup=1;flashimg=1
/product_image           emmc      /dev/block/by-name/product                                       flags=display="Product Image";backup=1;flashimg=1
/system_ext_image        emmc      /dev/block/by-name/system_ext                                    flags=display="System_EXT Image";backup=1;flashimg=1
/vendor_dlkm_image       emmc      /dev/block/by-name/vendor_dlkm                                   flags=display="Vendor DLKM Image";backup=1;flashimg=1
/system_dlkm_image       emmc      /dev/block/by-name/system_dlkm                                   flags=display="System DLKM Image";backup=1;flashimg=1

# Storage
/metadata                f2fs      /dev/block/platform/3c400000.ufs/by-name/metadata                flags=display="Metadata"
/userdata                f2fs      /dev/block/platform/3c400000.ufs/by-name/userdata                flags=display="Userdata";encryptable=/metadata/vold/metadata_encryption

# Removable storage
/usb_otg                 vfat      /dev/block/sdg1              /dev/block/sdg                      flags=display="USB-OTG";storage;wipeingui;removable
