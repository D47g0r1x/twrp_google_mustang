# Android fstab file for TWRP on Pixel 10 Pro XL (mustang / laguna)
#
#<src>                                                   <mnt_point>                 <type>  <mnt_flags and options>                                                                                     <fs_mgr_flags>
/dev/block/platform/3c400000.ufs/by-name/boot            /boot                       emmc    defaults                                                                                                     slotselect
/dev/block/platform/3c400000.ufs/by-name/init_boot       /init_boot                  emmc    defaults                                                                                                     slotselect
/dev/block/platform/3c400000.ufs/by-name/vendor_boot      /vendor_boot                emmc    defaults                                                                                                     slotselect
/dev/block/platform/3c400000.ufs/by-name/vendor_kernel_boot /vendor_kernel_boot       emmc    defaults                                                                                                     slotselect
/dev/block/platform/3c400000.ufs/by-name/misc            /misc                       emmc    defaults                                                                                                     defaults
/dev/block/platform/3c400000.ufs/by-name/vbmeta          /vbmeta                     emmc    defaults                                                                                                     slotselect
/dev/block/platform/3c400000.ufs/by-name/vbmeta_system   /vbmeta_system              emmc    defaults                                                                                                     slotselect
/dev/block/platform/3c400000.ufs/by-name/vbmeta_vendor   /vbmeta_vendor              emmc    defaults                                                                                                     slotselect

# Dynamic logical partitions
system                                                   /system                     ext4    ro                                                                                                           wait,slotselect,logical,first_stage_mount
system_dlkm                                              /system_dlkm                ext4    ro                                                                                                           wait,slotselect,logical,first_stage_mount
system_ext                                               /system_ext                 ext4    ro                                                                                                           wait,slotselect,logical,first_stage_mount
product                                                  /product                    ext4    ro                                                                                                           wait,slotselect,logical,first_stage_mount
vendor                                                   /vendor                     ext4    ro                                                                                                           wait,slotselect,logical,first_stage_mount
vendor_dlkm                                              /vendor_dlkm                ext4    ro                                                                                                           wait,slotselect,logical,first_stage_mount

# Metadata & Userdata
/dev/block/platform/3c400000.ufs/by-name/metadata        /metadata                   f2fs    noatime,nosuid,nodev,sync                                                                                    wait,check,formattable,first_stage_mount
/dev/block/platform/3c400000.ufs/by-name/userdata        /data                       f2fs    noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier,atgc,checkpoint_merge      latemount,wait,check,quota,formattable,reservedsize=128M,checkpoint=fs,fileencryption=aes-256-xts:aes-256-hctr2,metadata_encryption=,keydirectory=/metadata/vold/metadata_encryption
