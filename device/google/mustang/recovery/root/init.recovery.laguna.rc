on early-init
    # Set up basic security nodes
    chmod 0660 /dev/citadel
    chown hsm hsm /dev/citadel
    chmod 0660 /dev/trusty-ipc-dev0
    chown system system /dev/trusty-ipc-dev0

on init
    wait /sys/devices/platform/simple_usb_bus/c450000.usb3/c400000.dwc3/driver 10
    setprop sys.usb.controller "c400000.dwc3"
    setprop sys.usb.configfs 1

on post-fs
    # Start citadel and keymint services if present
    start citadeld
    start vendor.keymint-citadel
    start vendor.weaver_hal_aidl
    start vendor.gatekeeper_default

on init && property:ro.debuggable=1 && property:ro.boot.mode=recovery
    start recovery-console

service recovery-console /system/bin/sh
    class core
    console
    disabled
    user root
    group root shell log readproc
    seclabel u:r:su:s0
    setenv HOSTNAME console
